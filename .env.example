SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Server only. Get this from Supabase Settings > API Keys. Never put it in Expo.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SECRET_OR_SERVICE_ROLE_KEY
MODELS_DIR=./models
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
MAX_VIDEO_BYTES=52428800
MAX_VIDEO_SECONDS=60
VIDEO_PROCESSING_SECONDS=45
REDIS_URL=redis://127.0.0.1:6379/0
LIVE_INTERVAL_MS=1000
MAX_LIVE_FRAME_BYTES=2097152
LIVE_SESSION_SECONDS=600
INFERENCE_CONCURRENCY=2
INFERENCE_QUEUE_SECONDS=10
